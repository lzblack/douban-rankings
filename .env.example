# Copy to .env (gitignored) and fill in. Used only by `pnpm run enrich`.
# Get a free key at https://mdblist.com/preferences/ (~1000 req/day).
MDBLIST_API_KEY=

# Optional tuning (defaults shown):
# Per-run HTTP request budget — keeps a single run under MDBList's daily quota
# (a title costs 1 request, or 2 when the movie/show fallback fires).
# MDBLIST_MAX_REQUESTS=900
# Refetch a title's ratings only when older than this many days.
# MDBLIST_TTL_DAYS=90
# Recheck a "MDBList had no data" title (negative cache) on this shorter TTL,
# so titles later added to MDBList get picked up without churning every run.
# MDBLIST_NEGATIVE_TTL_DAYS=30
