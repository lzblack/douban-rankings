# Copy to .env (gitignored) and fill in. Used only by `pnpm run enrich`.
# Get a free key at https://mdblist.com/preferences/ (~1000 req/day).
MDBLIST_API_KEY=

# Optional tuning (defaults shown):
# Per-run request cap — keeps a single run under MDBList's daily quota.
# MDBLIST_MAX_REQUESTS=900
# Refetch a title's ratings only when older than this many days.
# MDBLIST_TTL_DAYS=90
